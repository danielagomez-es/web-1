<section class="contact-section" id="{{ page.header.anchor|default('contacto') }}">
  <div class="contact-section__halo"></div>
  <div class="section-kicker"><span>{{ page.header.section_number }}</span><span class="section-kicker__line"></span><span>{{ page.header.section_label }}</span></div>
  <div class="contact-section__content">
    <p class="eyebrow">{{ page.header.eyebrow }}</p>
    <p class="eyebrow">{{ page.header.eyebrow_secondary }}</p>
    <h2>{{ page.header.heading }}<br /><em>{{ page.header.accent_title }}</em></h2>
    <p>{{ page.header.body }}</p>
    <p class="whatsapp-note">{{ page.header.note }}</p>
    <a class="button button--primary button--large" href="{{ page.header.button_url }}"><span class="button__dot"></span> {{ page.header.button_label }}</a>
  </div>
  <p class="social-proof">{{ page.header.proof }}</p>
  <div class="social-links">
    {% for link in page.header.links|default([]) %}
    <a href="{{ link.url }}"><span>{{ link.label }}</span><strong>{{ link.handle }}</strong><span>↗</span></a>
    {% endfor %}
  </div>
</section>
